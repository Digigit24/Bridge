# ─── Server ──────────────────────────────────────────────
PORT=3000

# ─── Database (Neon / any Postgres with pgvector) ────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Notion — pick ONE of the two methods below ──────────

# METHOD A: Internal Integration Token (recommended for local dev)
# Get it from https://www.notion.so/my-integrations → New integration → Internal
# Then share each database with the integration (••• → Add connections)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# METHOD B: OAuth (for production with a public HTTPS domain)
# Create a Public integration at https://www.notion.so/my-integrations
# Set redirect URI to https://yourdomain.com/auth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/auth/notion/callback

# Notion API version (do not change)
NOTION_VERSION=2022-06-28

# ─── Notion Webhook (optional) ───────────────────────────
# Secret shown when you register a webhook in Notion
NOTION_WEBHOOK_SECRET=

# ─── n8n ─────────────────────────────────────────────────
DEFAULT_N8N_WEBHOOK_URL=https://your-n8n.com/webhook/your-webhook-id

# ─── OpenAI (required for RAG / knowledge base) ──────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
